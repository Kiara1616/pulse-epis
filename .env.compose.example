PULSE_POSTGRES_DB=pulse_epis
PULSE_POSTGRES_USER=pulse
PULSE_POSTGRES_PASSWORD=replace-with-a-local-random-password
PULSE_AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
PULSE_ENVIRONMENT=development
PULSE_AUTH_PROVIDER=local
PULSE_LOCAL_AUTH_SEED=true
PULSE_LOCAL_AUTH_PASSWORD=pulse-local-demo
PULSE_AUTH_COOKIE_SECURE=false
PULSE_AUTH_COOKIE_SAMESITE=lax
PULSE_ROSTER_PSEUDONYM_SECRET=replace-with-a-different-random-secret
PULSE_EVIDENCE_ACCESS_SECRET=replace-with-another-random-secret
PULSE_AUTH_SUCCESS_REDIRECT=http://localhost:3000/
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Demo accounts are seeded only in development:
# admin@local.pulse-epis.test
# validator@local.pulse-epis.test
# student@local.pulse-epis.test
# For staging/production use PULSE_AUTH_PROVIDER=google and configure the
# Google OIDC variables in the environment-specific file.
