STAGING_DOMAIN=staging.example.org
PUBLIC_DOMAIN=staging.example.org
PULSE_ENVIRONMENT=staging
PULSE_API_PREFIX=/api/v1
PULSE_CORS_ALLOWED_ORIGINS=https://staging.example.org
PULSE_LOG_LEVEL=INFO
PULSE_POSTGRES_DB=pulse_epis
PULSE_POSTGRES_USER=pulse
PULSE_POSTGRES_PASSWORD=replace-with-a-random-password
PULSE_GOOGLE_CLIENT_ID=replace-with-google-client-id
PULSE_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
PULSE_GOOGLE_REDIRECT_URI=https://staging.example.org/api/v1/auth/google/callback
PULSE_GOOGLE_ALLOWED_DOMAINS=virtual.upt.pe,upt.edu.pe
PULSE_AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
PULSE_AUTH_COOKIE_SECURE=true
PULSE_AUTH_COOKIE_SAMESITE=lax
PULSE_ROSTER_PSEUDONYM_SECRET=replace-with-a-different-random-secret
PULSE_EVIDENCE_ACCESS_SECRET=replace-with-another-random-secret
PULSE_AUTH_SUCCESS_REDIRECT=https://staging.example.org/
NEXT_PUBLIC_API_URL=https://staging.example.org/api/v1
