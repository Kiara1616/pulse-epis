flowchart LR
  subgraph Sources[Fuentes autorizadas]
    R[Padrón EPIS]
    C[Certificaciones y evidencias]
    V[Validaciones]
    L[Catálogo y oportunidades]
  end
  subgraph Operational[Zona operacional]
    PG[(Cloud SQL PostgreSQL)]
  end
  subgraph Pipeline[Procesamiento]
    JOB[Cloud Run Job ETL]
    Q[Calidad, normalización y hash]
  end
  subgraph Lake[Data Lake Cloud Storage]
    P1[period_code]
    P2[cutoff_date]
    J1[fact_student_period.jsonl]
    J2[fact_certification.jsonl]
    M[manifest.json]
  end
  subgraph DW[Data Warehouse PostgreSQL]
    D1[Periodo / fecha]
    D2[Estudiante seudonimizado]
    D3[Emisor / credencial / habilidad]
    F1[(fact_student_period)]
    F2[(fact_certification)]
  end
  subgraph BI[Consumo]
    API[API temporal]
    REP[6 reportes BI]
    EXP[CSV / XLSX / PDF]
  end
  R --> PG
  C --> PG
  V --> PG
  L --> PG
  PG --> JOB --> Q
  Q --> P1 --> P2
  P2 --> J1
  P2 --> J2
  P2 --> M
  Q --> F1
  Q --> F2
  D1 --> F1
  D2 --> F1
  D3 --> F2
  F1 --> API
  F2 --> API
  API --> REP --> EXP
