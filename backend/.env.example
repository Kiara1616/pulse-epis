# Non-secret local API settings. Copy to .env when needed.
PULSE_ENVIRONMENT=development
PULSE_API_PREFIX=/api/v1
PULSE_LOG_LEVEL=INFO
# Local-only example; use a secret manager for shared environments.
# PULSE_DATABASE_URL=postgresql+psycopg://pulse:pulse@localhost:5432/pulse_epis
# Google OIDC identity-only flow; never add Gmail scopes or credentials to the repo.
# PULSE_GOOGLE_CLIENT_ID=replace-with-google-client-id
# PULSE_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# PULSE_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# PULSE_GOOGLE_ALLOWED_DOMAINS=virtual.upt.pe,upt.edu.pe
# PULSE_AUTH_SESSION_SECRET=replace-with-a-random-secret
# PULSE_AUTH_COOKIE_SECURE=false
# PULSE_ROSTER_ALLOWED_SCHOOLS=EPIS
# PULSE_ROSTER_ALLOWED_STATUSES=ACTIVE,INACTIVE,GRADUATED
# PULSE_ROSTER_PSEUDONYM_SECRET=replace-with-a-different-random-secret
# PULSE_ROSTER_MAX_BYTES=5000000
# PULSE_ROSTER_MAX_ROWS=10000
